# syntax=docker/dockerfile:1.7
# =============================================================================
# Frontend (Next.js 15 App Router) — multi-stage build.
#   1) deps  → ayrı katman: package.json + lockfile ile ``npm install``
#   2) build → source kopyala + next build
#   3) runner→ ``next start -p 3000`` non-root user ile çalıştır
#
# ``NEXT_PUBLIC_*`` değerleri build arg / env olarak GNB sırasında bundle
# içine yazılır; runtime'da override edilemez. Compose same-origin
# ``/api`` kullanır — PANEL_PORT değişince rebuild gerekmez.
# =============================================================================

# ---- 1. deps -------------------------------------------------------------
FROM node:20-alpine AS deps

WORKDIR /app

# Lockfile varsa ``npm ci`` ile deterministic; yoksa ``npm install``.
# Alpine'da libc uyumsuz paketlerini ``--ignore-scripts`` ile atla — node-
# gyp build'leri glacier tarafı ekstra yük getirir; sonradan tekrar yok.
COPY frontend/package.json       /app/package.json
COPY frontend/package-lock.json  /app/package-lock.json

RUN if [ -f /app/package-lock.json ]; then \
      npm ci --no-audit --no-fund --prefer-offline; \
    else \
      echo "package-lock.json yok; npm install kullanılıyor" && \
      npm install --no-audit --no-fund --prefer-offline; \
    fi

# ---- 2. build ------------------------------------------------------------
FROM node:20-alpine AS build

WORKDIR /app

ARG NEXT_PUBLIC_API_BASE_URL=/api

ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./

# ``next.config.ts`` next 15 ile CI'da bunu destekler.
RUN npm run build

# ---- 3. runner -----------------------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# next start default 3000, container içinde sabit 3000; host portu compose'da.
# Alpine'da user için shadow-utils zorunlu değil; adduser/addgroup built'in.
RUN addgroup -g 1001 -S nodejs \
 && adduser -S nextjs -u 1001

# build katmanındaki çıktıları kopyala. ``.next/cache`` build-time artifact;
# üretimde irrelevant. public klasörü Next tarafından silinmiş olabilir
# (statikler next ile birlikte), yokluğu sorun değil.
COPY --from=build --chown=nextjs:nodejs /app/.next          ./.next
COPY --from=build --chown=nextjs:nodejs /app/node_modules   ./node_modules
COPY --from=build --chown=nextjs:nodejs /app/package.json   ./package.json
COPY --from=build --chown=nextjs:nodejs /app/next.config.ts ./next.config.ts

USER nextjs

EXPOSE 3000

# Local binary — `npx` non-root home'a yazmaya çalışabilir.
CMD ["./node_modules/.bin/next", "start", "-p", "3000", "-H", "0.0.0.0"]
