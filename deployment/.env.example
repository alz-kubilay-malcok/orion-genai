# Deployment — minimal env contract.
#
# Bu dosya gerçek değerler içermez. ``.env`` kopyalanır, secret'lar
# tarafınızdan set edilir. Compose `env_file:` ile otomatik okur.
#
# Aşağıdaki örnekler composetaki default'ları override eder; kullanmak
# istemediğiniz satır başına ``#`` koyabilirsiniz.

# --- Uygulama ortamı ------------------------------------------------------
APP_ENV=dev                                # dev|stg|prod; prod'da settings.validate_production() fail-fast.

# --- DB --------------------------------------------------------------------
DB_MODE=pg
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=panel
# Postgres container'ı + backend-api/container worker aynı secret'ı tüketir.
# Compose ``${DB_PASSWORD:-OrionPanel123!}`` default yeterlidir; secret
# manager üzerinden override etmek için ``.env`` dosyasına set edin.
DB_PASSWORD=OrionPanel123!
DB_NAME=panel
SQLITE_ABS_PATH=                           # pg modunda yok sayılır
CONN_POOL_SIZE=5

# --- Backend API ------------------------------------------------------------
PROCESS_ROLE=api
PORT=8000                                  # container içinde; host portu compose'da
API_HOST=0.0.0.0
API_LOG_LEVEL=info
GENAI_ORION_PANEL_CORS_ORIGINS=http://localhost:8058,http://localhost:3000

# --- Outbox worker ---------------------------------------------------------
WORKER_INTERNAL_SECONDS=10
WORKER_LEASE_SECONDS=120
WORKER_BATCH_SIZE=8
LITELLM_RETRY=10
LITELLM_HOLD_MINUTES=5
MAIL_RETRY_MAX=5
MAIL_RETRY_BACKOFF_SECONDS=60

# Worker health probe (deployment/scripts/worker_wrapper.py)
WORKER_HEALTH_PORT=8057                    # container iç portu; host portu compose'da
WORKER_HEALTH_HOST=0.0.0.0
WORKER_MIN_UPTIME_SECONDS=15
WORKER_STALE_AFTER_SECONDS=180
WORKER_HEARTBEAT_CHECK=false               # true: ``worker_heartbeats.last_seen_at`` okunur
WORKER_ID=panel-worker-1
WORKER_CHILD_CMD=python main.py worker

# --- Mail + JWT-secrets ----------------------------------------------------
# Settings bazı secret'ları prod'da zorunlu kılar (``settings.validate_production``).
MAIL_PROVIDER=placeholder                  # placeholder|smtp
APP_JWT_SECRET=change-me-32-bytes-of-base64-or-hex
MAIL_JWT_SECRET=change-me-also-32-bytes
ACTION_SIGNING_SECRET=change-me-please-32-bytes-or-more0123456789

# --- LDAP ------------------------------------------------------------------
# Bu blok LDAP pre-flight gating'ini kontrol eder. ``docker compose
# --profile ldap up`` ile ``openldap`` ve ``ldap-ui`` servisleri de
# kalkar; aksi halde sadece LDAP_ENABLED=true bile bir şeyi bağlamaz —
# backend DNS çözümlemesi yapamaz.
#
# Prod'da ``LDAP_HOST=ldaps://...`` ve ``LDAP_USE_SSL=true`` ile kendi
# AD'nize yönelin. Default değerler sadece ``--profile ldap`` ile açılan
# local Bitnami OpenLDAP içindir.
LDAP_ENABLED=false
LDAP_OPENLDAP_HOST=openldap                 # docker DNS adı; ``--profile ldap`` ile açılır
LDAP_OPENLDAP_PORT=1389
LDAP_BIND_DN=cn=admin,dc=example,dc=org
LDAP_BIND_PASSWORD=adminpassword
LDAP_SEARCH_BASE=ou=users,dc=example,dc=org
LDAP_USER_FILTER=(uid={username})
LDAP_USE_SSL=false
LDAP_CONNECT_TIMEOUT=5

# --- Hooks -----------------------------------------------------------------
GENAI_ORION_PANEL_WEBHOOK_SECRET=change-me-webhook-hmac-32-bytes

# --- Frontend -------------------------------------------------------------
# build-time bake edilir (``NEXT_PUBLIC_*``); runtime'da değişmez.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8056
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:8058
