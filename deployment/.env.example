# Deployment — prod/compose için TEK env dosyası.
#   cp deployment/.env.example deployment/.env
# Backend process + worker + frontend build-args + Postgres hepsi buradan.
# ``backend/.env`` prod'da kullanılmaz (image'a COPY de edilmez).
# LDAP bind password stays in this file (env_file). Compose environment: ezmez.
#
# Host portları prdgenai01'de 8056-8058 boş (2026-08-25 docker ps).
# Dolu — bind ETME: 5432, 6379, 8000-8055, 8065, 8067, 8077, 8081, 8090.
# PORT=8000 container-içi uvicorn; host mapping PANEL_API_HOST_PORT.

# --- App -------------------------------------------------------------------
ENVIRONMENT=dev                            # dev|stg|prod

# --- Host ports (compose publish; container içi port değil) ----------------
# Port değiştirirsen CORS + PUBLIC_ACTION_BASE_URL + NEXT_PUBLIC_* de güncelle.
PANEL_API_HOST_PORT=8056
PANEL_WORKER_HOST_PORT=8057
PANEL_WEB_HOST_PORT=8058

# --- DB --------------------------------------------------------------------
# Tek kaynak: hem Postgres hem backend/worker bunu okur. PANEL_DB_PASSWORD yok.
# İlk `compose up` volume'u bu user/parola ile init eder; sonradan değiştirirsen
# `docker volume rm genai-orion-panel_panel_pg_data` (data silinir).
DB_MODE=pg
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=panel
DB_PASSWORD=OrionPanel123!
DB_NAME=panel
CONN_POOL_SIZE=5

# --- Backend API ------------------------------------------------------------
# PROCESS_ROLE compose servisine göre api|worker basar; buraya yazma.
PORT=8000
API_HOST=0.0.0.0
API_LOG_LEVEL=info
GENAI_ORION_PANEL_CORS_ORIGINS=http://localhost:8058,http://localhost:3000
PUBLIC_ACTION_BASE_URL=http://localhost:8058/approvals
APPROVER_EMAILS=approver@example.com

# --- Outbox worker ---------------------------------------------------------
WORKER_INTERNAL_SECONDS=10
WORKER_LEASE_SECONDS=120
WORKER_BATCH_SIZE=8
WORKER_HEALTH_PORT=8057
WORKER_HEALTH_HOST=0.0.0.0
WORKER_MIN_UPTIME_SECONDS=15
WORKER_STALE_AFTER_SECONDS=180
WORKER_HEARTBEAT_CHECK=false
WORKER_ID=panel-worker-1
WORKER_CHILD_CMD=python main.py worker

# --- Secrets ---------------------------------------------------------------
MAIL_PROVIDER=placeholder
# Allianz dahili relay (örnek Assistai kodu ile aynı host:25, auth yok).
# Canlı: MAIL_PROVIDER=smtp
SMTP_SERVER=mailenable.allianz-tr.local
SMTP_PORT=25
SMTP_TIMEOUT=15
SMTP_SENDER=GenAi Key Dispatcher <genai_key_dispatcher@info.com>
JWT_SECRET=change-me-32-bytes-of-base64-or-hex
ACTION_SIGNING_SECRET=change-me-please-32-bytes-or-more0123456789
# 32-byte AES key, base64. Rotate in prod:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
KEY_ENCRYPTION_KEY=b3Jpb24tbG9jYWwtZGV2LWFlcy0zMmJ5dGUta2V5ISE=
KEY_ENCRYPTION_KEY_VERSION=1
BOOTSTRAP_ADMIN_USERNAME=admin@local
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_EMAIL=admin@local

# --- LDAP (Allianz Active Directory) --------------------------------------
# Compose LDAP_* basmaz. Bu dosyayı ``.env`` olarak kopyala, sırları doldur.
# Yerel docker: false. Allianz AD: true + bind/CA doldur.
# ``deployment/certs/*.pem`` container'da ``/etc/ssl/corp/`` altına mount.
# Parolayı compose ``environment:`` bloğuna yazma ($ interpolasyonu).
LDAP_ENABLED=false
LDAP_HOST=dc01.corp.example.com
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_TLS_VERIFY=true
LDAP_CA_CERT=/etc/ssl/corp/ca-bundle.pem
LDAP_CONNECT_TIMEOUT=5
LDAP_BASE_DN=DC=corp,DC=example,DC=com
LDAP_BIND_DN=CN=svc-orion,OU=Service Accounts,DC=corp,DC=example,DC=com
LDAP_BIND_PASSWORD=
LDAP_USER_ATTR=sAMAccountName
LDAP_MAIL_ATTR=mail
LDAP_DISPLAY_NAME_ATTR=displayName
LDAP_OBJECT_CLASS=user
LDAP_GROUP_MEMBER_ATTR=memberOf
LDAP_ADMIN_GROUP=CN=orion-admins,OU=Groups,DC=corp,DC=example,DC=com
LDAP_REQUIRED_GROUP=CN=orion-users,OU=Groups,DC=corp,DC=example,DC=com
LDAP_ALLOW_LOCAL_FALLBACK=true
ALLOW_PROD_LOCAL_BREAK_GLASS=false
ALLOW_PROD_INSECURE_LDAP_TLS=false

# --- Hooks -----------------------------------------------------------------
GENAI_ORION_PANEL_WEBHOOK_SECRET=change-me-webhook-hmac-32-bytes
# hmac = X-GenAi-Orion-Panel-Signature zorunlu. off = imza yok (yalnız local).
GENAI_ORION_PANEL_WEBHOOK_AUTH_MODE=hmac

# --- LiteLLM / MCP (worker env_file) --------------------------------------
# Yeni LiteLLM/MCP container açma. prdgenai01'de zaten var:
#   litellm-litellm-1          host :8000
#   mcp-gateway-mcp-eval-1     host :8030
# Compose extra_hosts: host.docker.internal → host-gateway.
LITELLM_KEY_GENERATE_PATH=/key/generate
LITELLM_BASE_URL=http://host.docker.internal:8000
LITELLM_MASTER_KEY=
LITELLM_BASE_URL_DEV=
LITELLM_MASTER_KEY_DEV=
LITELLM_BASE_URL_STG=
LITELLM_MASTER_KEY_STG=
LITELLM_BASE_URL_PROD=
LITELLM_MASTER_KEY_PROD=
MCP_GATEWAY_KEY_CREATE_PATH=/mcp/keys/create
# MCP key create URL — yeni gateway ayağa kaldırma; mevcut host servisine işaret et.
MCP_GATEWAY_BASE_URL=
MCP_GATEWAY_ADMIN_CREDENTIAL=
MCP_GATEWAY_BASE_URL_TEST=
MCP_GATEWAY_ADMIN_CREDENTIAL_TEST=
MCP_GATEWAY_BASE_URL_PROD=
MCP_GATEWAY_ADMIN_CREDENTIAL_PROD=

# --- Frontend (build-time) ------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8056
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:8058
