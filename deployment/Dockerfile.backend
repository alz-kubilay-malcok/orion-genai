# syntax=docker/dockerfile:1.7
# =============================================================================
# Backend image — modular monolith, tek image / iki process (api | worker).
# Varsayılan: ``python main.py`` (migrate + api + worker, ADR-004 ihlali).
# Compose dosyasında her service için ``command:`` override edilir:
#   - backend-api:    python main.py migrate && python main.py api
#   - backend-worker: /app/deployment/scripts/worker_wrapper.py
# =============================================================================

FROM python:3.12-alpine AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

WORKDIR /app

# musl: asyncpg/cryptography/bcrypt için derleyici + libpq.
# slim (Debian) bu host'ta pull edilmiyor; alpine catalog'da var.
RUN apk add --no-cache \
        build-base \
        linux-headers \
        libffi-dev \
        openssl-dev \
        postgresql-dev \
        libpq \
        curl

# ---- Requirements: önce yalnız bu dosya kopyalanır (layer cache).
COPY backend/requirements.txt /app/backend/requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip wheel \
 && pip install -r /app/backend/requirements.txt

COPY backend/     /app/backend/
COPY deployment/  /app/deployment/

# ---- Runtime env. ``PROCESS_ROLE`` default api; compose'da override edilir.

ENV PROCESS_ROLE=api \
    PORT=8000 \
    API_HOST=0.0.0.0 \
    API_LOG_LEVEL=info \
    DB_MODE=pg \
    ENVIRONMENT=dev

# Portlar: 8000 uvicorn (api). Worker probe container-içi; host publish yok.

EXPOSE 8000

# ---- Sağlık: container ayakta mı? Apiden farklı bir ``HEALTHCHECK``
# tanımlanırsa compose öncelik alır. Buraya default bırakılmadı çünkü
# ``command`` geçersiz kılındığında CMD'nin kendisi sağlıklı olur;
# her service healthcheck'i kendi içinde tanımlar.

# Default process supervisor entry. Compose dosyalarında override gerekir.
CMD ["python", "backend/main.py", "api"]
