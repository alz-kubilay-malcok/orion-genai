# syntax=docker/dockerfile:1.7
# =============================================================================
# Backend — Debian slim, BUILD'de apt YOK (pip wheel).
# Kurumsal proxy: ARG http_proxy/https_proxy (compose shell'den geçer).
# ARG imaja yazılmaz; yalnız bu RUN'da pip görür.
# =============================================================================

FROM python:3.12-slim-bookworm

ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ONLY_BINARY=:all: \
    PYTHONPATH=/app

WORKDIR /app

COPY backend/requirements.txt /app/backend/requirements.txt

RUN pip install --upgrade pip wheel \
 && pip install -r /app/backend/requirements.txt

COPY backend/     /app/backend/
COPY deployment/  /app/deployment/

ENV PROCESS_ROLE=api \
    PORT=8000 \
    API_HOST=0.0.0.0 \
    API_LOG_LEVEL=info \
    DB_MODE=pg \
    ENVIRONMENT=dev

EXPOSE 8000

CMD ["python", "backend/main.py", "api"]
