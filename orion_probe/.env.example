# cp orion_probe/.env.example orion_probe/.env
# .env commit edilmez.

# Prod (TLS reverse proxy). Host doğrudan: http://10.70.6.165:8020
# Direkt FastAPI: http://127.0.0.1:8000 — o zaman API_PREFIX boş bırak
BASE_URL=https://genai-management.allianz-tr.local
API_PREFIX=/api

# deployment/.env içindeki GENAI_ORION_PANEL_WEBHOOK_SECRET ile aynı olmalı
HMAC_SECRET=change-me-webhook-hmac-32-bytes

# Katalog sorgusu: TEST | PROD
CATALOG_ORTAM=PROD

# Windows kurumsal proxy .local'e SOCKS/HTTP gateway 504 basar.
# Varsayılan: proxy yok (iç DNS). Dışarıdan deniyorsan USE_PROXY=1
USE_PROXY=0
