# cp orion_probe/.env.example orion_probe/.env
# .env commit edilmez.

# Nginx (compose): http://<host>:<PANEL_PORT>  — path'ler /api/...
# Direkt FastAPI:  http://127.0.0.1:8000      — o zaman API_PREFIX boş bırak
BASE_URL=http://127.0.0.1:8020
API_PREFIX=/api

# deployment/.env içindeki GENAI_ORION_PANEL_WEBHOOK_SECRET ile aynı olmalı
HMAC_SECRET=change-me-webhook-hmac-32-bytes

# Katalog sorgusu: TEST | PROD
CATALOG_ORTAM=PROD
