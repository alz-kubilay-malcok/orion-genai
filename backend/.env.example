# GenAiOrionPanel — backend env şablonu (YALNIZ yerel `python main.py`)
#
# Prod / Docker: tek dosya ``deployment/.env``
#   cp deployment/.env.example deployment/.env
#   sırları doldur, ``docker compose up`` — backend/.env verme.
#   Image .env COPY etmez; compose ``env_file`` host'tan process env'e basar.
#
# Local smoke:  cp backend/.env.example backend/.env
# pydantic Settings env adlarını case-insensitive okur (LDAP_HOST = ldap_host).
# Değerlerde tırnak kullanma. # yorum satırıdır.
# Sırlar Vault'tan inject edilir; .env commit edilmez.

# =============================================================================
# 1. Süreç
# =============================================================================
# dev | stg | prod  — prod'da Settings.validate_production() JWT/LDAP/bootstrap kapısı çalışır.
ENVIRONMENT=dev
DEBUG=false
# api | worker  — compose override eder. Yerel `python main.py all` için gerekmez.
# PROCESS_ROLE=api
PORT=8000
API_HOST=127.0.0.1
API_LOG_LEVEL=info
# uvicorn forwarded-allow-ips. Prod reverse-proxy IP'leri; `*` yalnız local.
API_TRUSTED_HOSTS=*

# CORS — tarayıcının açtığı frontend origin (scheme+host+port). Virgülle ayır.
GENAI_ORION_PANEL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8056,http://127.0.0.1:8056

# Mail aksiyon linklerinin tabanı (HMAC token path: {base}/{token}).
# Local next: http://localhost:3000/approvals
# Compose:    ${PUBLIC_BASE_URL}/approvals (nginx PANEL_PORT)
# Prod:       https://<panel-host>/approvals
PUBLIC_ACTION_BASE_URL=http://localhost:3000/approvals
ACTION_TOKEN_TTL_HOURS=72

# =============================================================================
# 2. PostgreSQL
# =============================================================================
# sqlite | pg   — prod = pg. sqlite yalnız tek-process smoke.
DB_MODE=pg
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin
DB_NAME=genai_orion
CONN_POOL_SIZE=5
# DB_MODE=sqlite iken (prod kullanma):
# SQLITE_ABS_PATH=./panel.db

# =============================================================================
# 3. Login JWT + onay-mail HMAC  (iki ayrı sır)
# =============================================================================
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
# Onay/revize/red link imzası. JWT_SECRET ile aynı olmasın.
ACTION_SIGNING_SECRET=change-me-min-32-chars-yyyyyyyyyyyyyyyyyyyy

# Login brute-force (IP+username).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=300

# =============================================================================
# 4. Bootstrap admin (LDAP yokken / break-glass)
# =============================================================================
# Prod + LDAP açıkken kapat: BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin@local
BOOTSTRAP_ADMIN_EMAIL=admin@local
# Local: admin. Prod açık kalırsa >=12 karakter, "admin" yasak.
BOOTSTRAP_ADMIN_PASSWORD=admin

# Virgülle: config_approvers (scope=GENAI_APPROVAL) seed.
APPROVER_EMAILS=approver@example.com

# =============================================================================
# 5. LDAP / Active Directory  — ayrıntı: docs/ldap_active_directory_setup.md
# =============================================================================
# Local smoke: false. Allianz AD: true + bind/CA/group DN doldur.
LDAP_ENABLED=false
LDAP_HOST=dc01.corp.example.com
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_TLS_VERIFY=true
# Tercih: PEM içeriği (tek satır, \\n ile). Dosya mount gerekmez.
LDAP_CA_CERT_PEM=
# Alternatif: container path. LDAP_CA_CERT_PEM doluysa yok sayılır.
# Container: /etc/ssl/corp/ca-bundle.pem  (deployment/certs mount)
LDAP_CA_CERT=
LDAP_CONNECT_TIMEOUT=5
LDAP_BASE_DN=DC=corp,DC=example,DC=com
LDAP_BIND_DN=CN=svc-orion,OU=Service Accounts,DC=corp,DC=example,DC=com
LDAP_BIND_PASSWORD=
# AD: sAMAccountName + objectClass=user. Settings default objectClass=person — AD'de user yaz.
LDAP_USER_ATTR=sAMAccountName
LDAP_MAIL_ATTR=mail
LDAP_DISPLAY_NAME_ATTR=displayName
LDAP_OBJECT_CLASS=user
LDAP_GROUP_MEMBER_ATTR=memberOf
# Düz (flat) memberOf. Nested group yok. Admin paneli is_superuser = bu grup.
LDAP_ADMIN_GROUP=CN=orion-admins,OU=Groups,DC=corp,DC=example,DC=com
LDAP_REQUIRED_GROUP=CN=orion-users,OU=Groups,DC=corp,DC=example,DC=com
# Local bcrypt login'e düş. Prod'da false; acil için ALLOW_PROD_LOCAL_BREAK_GLASS=true şart.
LDAP_ALLOW_LOCAL_FALLBACK=true
DEFAULT_NAMESPACE_SLUG=demo
ALLOW_PROD_LOCAL_BREAK_GLASS=false
ALLOW_PROD_INSECURE_LDAP_TLS=false

# =============================================================================
# 6. Orion webhook
# =============================================================================
# hmac = X-GenAi-Orion-Panel-Signature zorunlu. off = imza yok (yalnız local).
GENAI_ORION_PANEL_WEBHOOK_AUTH_MODE=hmac
GENAI_ORION_PANEL_WEBHOOK_SECRET=change-me-webhook-hmac-32-bytes

# =============================================================================
# 7. Secret at-rest  (LiteLLM/MCP plaintext key)
# =============================================================================
# 32 byte AES-256, base64. Boşsa worker her start'ta ephemeral üretir → eski secret çözülmez.
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
KEY_ENCRYPTION_KEY=
KEY_ENCRYPTION_KEY_VERSION=1
# KEY_ENCRYPTION_PREVIOUS_KEYS  — kodda okunmuyor (rotation henüz yok).

# =============================================================================
# 8. Mail
# =============================================================================
# placeholder | jsonfile | none | log  → test_env/mailbox (SMTP yok)
# smtp  → Allianz dahili relay
MAIL_PROVIDER=placeholder
MAIL_SINK_DIR=
SMTP_SERVER=mailenable.allianz-tr.local
SMTP_PORT=25
SMTP_TIMEOUT=15
SMTP_SENDER=GenAi Key Dispatcher <genai_key_dispatcher@info.com>
# MAIL_JWT_SECRET / MAIL_JWT_TTL_DAYS — legacy; aksiyon linkleri HMAC. Kullanılmıyor.

# =============================================================================
# 9. LiteLLM provision  (worker) — LLM + MCP key aynı proxy
# =============================================================================
# Ortam bazlı varsa o kazanır: LITELLM_BASE_URL_DEV / _STG / _PROD
# MCP form `TEST` → LITELLM_*_DEV. Ayrı MCP_GATEWAY_BASE_URL gerekmez.
LITELLM_BASE_URL=http://127.0.0.1:8200
LITELLM_MASTER_KEY=asd123
LITELLM_BASE_URL_DEV=
LITELLM_MASTER_KEY_DEV=
LITELLM_BASE_URL_STG=
LITELLM_MASTER_KEY_STG=
LITELLM_BASE_URL_PROD=
LITELLM_MASTER_KEY_PROD=
LITELLM_KEY_GENERATE_PATH=/key/generate
# MCP key de aynı LiteLLM `POST /key/generate` (object_permission.mcp_servers).
# Eski `/mcp/keys/create` LiteLLM'de yok; worker otomatik `/key/generate`'e map eder.
MCP_GATEWAY_KEY_CREATE_PATH=/key/generate
# GET /catalog/mcp-servers bunları LiteLLM'den anlık çeker.
LITELLM_MCP_SERVER_LIST_PATH=/v1/mcp/server
LITELLM_MCP_TOOLS_LIST_PATH=/mcp-rest/tools/list
# MCP_GATEWAY_SERVER_UPSERT_PATH — registry handler henüz dry-run; path okunmuyor.

# =============================================================================
# 10. Outbox worker
# =============================================================================
WORKER_INTERNAL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_BATCH_SIZE=8
LITELLM_RETRY=10
LITELLM_HOLD_MINUTES=5
MAIL_RETRY_MAX=5
MAIL_RETRY_BACKOFF_SECONDS=60
# Compose worker_wrapper (python main.py worker sarmalayıcı):
# WORKER_HEALTH_PORT=8057
# WORKER_HEALTH_HOST=127.0.0.1
# WORKER_MIN_UPTIME_SECONDS=15
# WORKER_STALE_AFTER_SECONDS=180
# WORKER_HEARTBEAT_CHECK=false
# WORKER_ID=panel-worker-1
# WORKER_CHILD_CMD=python main.py worker
# LOG_LEVEL=INFO

# =============================================================================
# 11. n8n lifecycle callback (approve / revise / reject)
# =============================================================================
# Karar sonucu maili gittikten sonra worker JSON POST eder:
# {jira_issue_key, status: approved|rejected}. Auth yok, şema yok. URL boşsa no-op.
# Workflow callback path: /webhook/genai-approve (inbound Jira path'i değil).
N8N_LIFECYCLE_WEBHOOK_URL=
N8N_LIFECYCLE_TLS_VERIFY=false
N8N_LIFECYCLE_TIMEOUT_SECONDS=15

# =============================================================================
# 12. Kodun okumadığı (baseline'da var, henüz wired değil)
# =============================================================================
# DATABASE_URL
# APP_ENV / APP_VERSION
# GENAI_ORION_PANEL_CATALOG_AUTH_MODE / GENAI_ORION_PANEL_CATALOG_CREDENTIAL
# INTERNAL_API_AUTH_MODE / INTERNAL_API_CREDENTIAL / BACKEND_SERVICE_TOKEN
# LITELLM_KEY_DURATION_DAYS
# MCP_EVALUATION_* / MCP_DISCOVERY_* / MCP_ALLOWED_HOSTS_* / MCP_REPO_ALLOWED_HOSTS_*
# MCP_PROD_MIN_TOOL_EVALUATION_SCORE
# CHATBOT_ASSIGNEE_EMAILS
# MAIL_FROM
# OUTBOX_POLL_SECONDS / OUTBOX_LEASE_SECONDS / OUTBOX_MAX_ATTEMPTS
# APPROVAL_EXPIRY_SCAN_SECONDS
# GENAI_ORION_PANEL_RAW_PAYLOAD_RETENTION_DAYS
