# Backend API base URL (server + client fetches via lib/api.ts).
# Docker compose publishes API on 8056. Local `python main.py api` uses 8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8056

# Public web base URL (mail action links / shareable URLs).
# Docker compose publishes frontend on 8058. Local `next dev` uses 3000.
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:8058
